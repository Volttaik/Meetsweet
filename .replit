modules = ["nodejs-20"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MeetSweet Server"

[[workflows.workflow]]
name = "MeetSweet Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && pnpm install && pnpm dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CLIENT_APP_ID = "meetsweet-mobile"
R2_ACCOUNT_ID = "e72d5cb6f9f658585db827cb12790c89"
R2_BUCKET_NAME = "meetsweet-media"
