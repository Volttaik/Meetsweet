# MeetSweet Mobile App — Environment Variables
#
# Copy to .env.local and fill in your values.

# Vercel deployment URL for the Next.js serverless backend.
# All API calls go to: https://<your-url>/api/<route>
# Example: https://meetsweet-server.vercel.app
EXPO_PUBLIC_API_URL=https://your-meetsweet-server.vercel.app
