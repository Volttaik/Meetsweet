# Turso
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket
R2_PUBLIC_BASE_URL=https://cdn.example.com

# Resend
RESEND_API_KEY=your-resend-api-key
VERIFIED_SENDER_EMAIL=noreply@example.com

# Authentication
JWT_SECRET=your-jwt-secret-min-32-chars
# Replit already provides this fallback in the current environment.
SESSION_SECRET=your-session-secret-min-32-chars

# Application metadata
APP_URL=https://your-broker.example.com
# Canonical public origin for share links and the landing page.
PUBLIC_APP_URL=https://meetsweet.space
CLIENT_APP_ID=meetsweet-mobile